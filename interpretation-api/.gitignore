# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binary, built with `go test -c`
*.test

# Code coverage profiles and other test artifacts
*.out
coverage.*
*.coverprofile
profile.cov

# Dependency directories
vendor/

# Go workspace files
go.work
go.work.sum

# env file
.env

# Temporary directory (used by live reloading tools like air)
tmp/

# Nginx SSL certificates (never commit private keys or certificates)
nginx/certs/*
!nginx/certs/.gitkeep